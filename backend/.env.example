# Copia este archivo como ".env" y completa tus propios valores.
# NUNCA subas el archivo ".env" real a GitHub (agrégalo a .gitignore).

# Cadena de conexión de MongoDB Atlas
# Ejemplo: mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/helpdesk?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/helpdesk

# Puerto en el que corre el servidor (Render lo asigna automáticamente en producción)
PORT=4000

# Origen permitido para CORS (URL de tu frontend desplegado en Vercel/Netlify)
CLIENT_ORIGIN=http://localhost:4200
